{
  "scripts": [
    {
      "//": "One browser-ready bundle: codejar and highlight.js travel inside it, so a <script> tag is the whole install.",
      "in": "src/code-preview.ts",
      "out": "dist/code-preview.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "justMinified": false,
        "format": "iife",
        "target": "es2019"
      }
    }
  ],
  "styles": [
    {
      "//": "Plain css in, plain css out — the point is a shipped dist/ that a consumer can link without a build of their own.",
      "in": "src/code-preview.css",
      "out": "dist/code-preview.css",
      "options": { "minify": true, "justMinified": false }
    },
    {
      "//": "Optional syntax colours, kept separate so a site with its own theme is not overridden.",
      "in": "src/code-preview-hljs.css",
      "out": "dist/code-preview-hljs.css",
      "options": { "minify": true, "justMinified": false }
    }
  ],
  "copy": [
    {
      "in": [
        "dist/code-preview.min.js",
        "dist/code-preview.min.css",
        "dist/code-preview-hljs.min.css",
        "example/src/sample.css"
      ],
      "out": "example/dist"
    }
  ],
  "markup": {
    "in": "example/src",
    "out": "example/dist"
  },
  "serve": {
    "port": 4042,
    "base": "/example/dist"
  },
  "livereload": true,
  "watch": ["src", "example/src"]
}
